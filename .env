# --- The one line that upgrades cBioPortal -------------------------------
# Bump this tag, re-run, done. Nothing else in this repo, and nothing at all in
# mtb-clinical-tools, is version-specific -- with the single exception of the
# runtime contract documented in mtb-clinical-tools/CONTRACT.md, which is a
# five-minute re-check per upgrade.
DOCKER_IMAGE_CBIOPORTAL=cbioportal/cbioportal:6.4.4

DOCKER_IMAGE_MYSQL=mysql:8.0
DOCKER_IMAGE_SESSION_SERVICE=cbioportal/session-service:0.6.4
DOCKER_IMAGE_MONGO=mongo:4.2

# --- Database ------------------------------------------------------------
DB_MYSQL_DB_NAME=cbioportal
DB_MYSQL_USERNAME=cbio_user
DB_MYSQL_PASSWORD=somepassword
# Quoted because init.sh sources this file with the shell, where a bare '&'
# would fork a background job. Compose strips the quotes.
DB_MYSQL_URL="jdbc:mysql://cbioportal-database:3306/cbioportal?useSSL=false&allowPublicKeyRetrieval=true"

# --- Ports ---------------------------------------------------------------
# On Windows, Hyper-V reserves TCP ranges and binding inside them fails with
# "forbidden by its access permissions" even though nothing is listening.
# Check with: netsh interface ipv4 show excludedportrange protocol=tcp
# Re-run ./init.sh after changing these, so frontend.json is regenerated.
CBIOPORTAL_PORT=9090
MTB_TOOLS_PORT=9091
# Only bound when the risk overlay is layered on.
MTB_RISK_PORT=9092

# --- The MTB bundle ------------------------------------------------------
# Where the bundle is built from. Docker builds it straight from GitHub, so
# only this repository needs cloning. To work on the bundle itself, clone it
# alongside this one and point at the checkout instead:
#   MTB_TOOLS_CONTEXT=../mtb-clinical-tools
MTB_TOOLS_CONTEXT=https://github.com/shaizalyasin/mtb-clinical-tools.git

# Origin the browser uses to fetch the bundle. Must be reachable from the
# browser, not from inside the compose network. Derived from MTB_TOOLS_PORT so
# there is only one place to change; init.sh renders it into
# config/frontend.json.
MTB_TOOLS_BASE_URL=http://localhost:${MTB_TOOLS_PORT}

# --- The survival risk model (optional overlay) --------------------------
# Built from its own repository, same pattern as the bundle above. Clone it
# alongside this one to work on it:
#   MTB_RISK_CONTEXT=../mtb-survival-model
MTB_RISK_CONTEXT=https://github.com/shaizalyasin/mtb-survival-model.git

# Origin the browser uses to reach the risk service. In this stack it is a
# separate port, so the Prognosis tab makes a cross-origin request and the
# service allows PUBLIC_URL explicitly. Behind the auth proxy this becomes
# /risk and the CORS question disappears.
MTB_RISK_BASE_URL=http://localhost:${MTB_RISK_PORT}

# Studies downloaded by init.sh and imported by import-study.sh.
#
# This is a space-separated LIST, not one study. cBioPortal hosts as many as
# you import and lists them all on its home page, so there is no reason to
# choose. Both get the same tabs, which is useful precisely because they behave
# differently:
#
#   lgg_ucsf_2014    0.7 MB, 1 minute.  No MSI, no FGA, no CNA profile, so the
#                    Prognosis tab correctly reports most inputs as missing.
#                    That is worth seeing: it is what an unsuitable study looks
#                    like, rather than a silent wrong answer.
#   msk_chord_2024   45 MB, 25,040 patients, and a long import. Same MSK-IMPACT
#                    panel family as the model's training cohort but patients
#                    it has never seen, so the Prognosis tab works properly.
#
# Start with just lgg_ucsf_2014 if you only want the base demo running quickly;
# add the second when you want the Prognosis tab to do something.
DATAHUB_STUDY="lgg_ucsf_2014 msk_chord_2024"

# --- Verification target -------------------------------------------------
# Which study/patient ./verify.sh and ./auth/verify-auth.sh drive. These take a
# single study, and default to the FIRST entry of DATAHUB_STUDY.
#
# asclc_msk_2024 carries mutations, CNA, structural variants and EQ-5D-5L
# timeline events, so it exercises far more of the store than lgg_ucsf_2014.
#
#   VERIFY_STUDY_ID=asclc_msk_2024
#   VERIFY_PATIENT_ID=P-0012905
VERIFY_STUDY_ID=
VERIFY_PATIENT_ID=P01

# --- Auth overlay --------------------------------------------------------
# Public origin the browser uses once auth/docker-compose.yml is layered on.
# Must match the Keycloak client redirect URIs in auth/realm-export.json.
PUBLIC_URL=http://localhost:9090
