# --- The one line that upgrades cBioPortal -------------------------------
# Bump this tag, re-run, done. Nothing else in this repo, and nothing at all in
# mtb-clinical-tools, is version-specific -- with the single exception of the
# runtime contract documented in mtb-clinical-tools/CONTRACT.md, which is a
# five-minute re-check per upgrade.
DOCKER_IMAGE_CBIOPORTAL=cbioportal/cbioportal:6.4.4

DOCKER_IMAGE_MYSQL=mysql:8.0
DOCKER_IMAGE_SESSION_SERVICE=cbioportal/session-service:0.6.4
DOCKER_IMAGE_MONGO=mongo:4.2

# --- Database ------------------------------------------------------------
DB_MYSQL_DB_NAME=cbioportal
DB_MYSQL_USERNAME=cbio_user
DB_MYSQL_PASSWORD=somepassword
# Quoted because init.sh sources this file with the shell, where a bare '&'
# would fork a background job. Compose strips the quotes.
DB_MYSQL_URL="jdbc:mysql://cbioportal-database:3306/cbioportal?useSSL=false&allowPublicKeyRetrieval=true"

# --- Ports ---------------------------------------------------------------
CBIOPORTAL_PORT=8090
MTB_TOOLS_PORT=8081

# --- The MTB bundle ------------------------------------------------------
# Where the bundle is built from. Docker builds it straight from GitHub, so
# only this repository needs cloning. To work on the bundle itself, clone it
# alongside this one and point at the checkout instead:
#   MTB_TOOLS_CONTEXT=../mtb-clinical-tools
MTB_TOOLS_CONTEXT=https://github.com/shaizalyasin/mtb-clinical-tools.git

# Origin the browser uses to fetch the bundle. Must be reachable from the
# browser, not from inside the compose network.
MTB_TOOLS_BASE_URL=http://localhost:8081

# Study downloaded by init.sh and imported by import-study.sh.
DATAHUB_STUDY=lgg_ucsf_2014

# --- Verification target -------------------------------------------------
# Which study/patient ./verify.sh and ./auth/verify-auth.sh drive. Defaults to the
# DataHub study above. Point it at a richer study once one is imported --
# asclc_msk_2024 carries mutations, CNA, structural variants and EQ-5D-5L
# timeline events, so it exercises far more of the store than lgg_ucsf_2014.
#
#   VERIFY_STUDY_ID=asclc_msk_2024
#   VERIFY_PATIENT_ID=P-0012905
VERIFY_STUDY_ID=
VERIFY_PATIENT_ID=P01

# --- Auth overlay --------------------------------------------------------
# Public origin the browser uses once auth/docker-compose.yml is layered on.
# Must match the Keycloak client redirect URIs in auth/realm-export.json.
PUBLIC_URL=http://localhost:8090
